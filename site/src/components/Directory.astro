---
import Analytics from '@vercel/analytics/astro';
import { type Locale } from '../lib/catalog';
import englishReadme from '../../../README.en.md?raw';
import chineseReadme from '../../../README.md?raw';
import { categoryLabel, kindOrder, repository, text } from '../lib/i18n';
import { emptySnapshot, formatCount, parseSnapshot, statsFor } from '../lib/stats';
import { createPublishedCatalog, packagePath, publishedRoutes, routePath } from '../lib/published-routes';
import Icon from './Icon.astro';
import '../styles/global.css';
import '../styles/directory-guides.css';

const { locale = 'en' } = Astro.props as { locale: Locale };
const catalog = createPublishedCatalog({ en: englishReadme, zh: chineseReadme });
const statsRaw = Object.values(import.meta.glob('../data/stats.json', { query: '?raw', import: 'default', eager: true }))[0] as string | undefined;
const stats = statsRaw ? parseSnapshot(statsRaw) : emptySnapshot();
const t = text[locale];
const base = locale === 'zh' ? '/zh/' : '/';
const canonicalUrl = new URL(base, Astro.site);
const socialImageUrl = new URL('/og-image-v4.png', Astro.site);
const categoryMap = new Map(catalog.categories.map(category => [category.id, category]));
const total = catalog.resources.length;
const categoryUrl = (id: string) => `${base}?category=${id}`;
const guides = Object.entries(publishedRoutes.categories).filter(([, route]) => route.status === 'active');
const jevPublished = publishedRoutes.topics.jev?.status === 'active';
const repoDestination = (url: string) => {
  const hostname = new URL(url).hostname;
  if (hostname === 'github.com' || hostname === 'www.github.com') return 'github';
  if (hostname === 'npmjs.com' || hostname === 'www.npmjs.com') return 'npm';
  return undefined;
};
const statsDate = stats.generatedAt
  ? new Intl.DateTimeFormat(locale === 'zh' ? 'zh-CN' : 'en-US', { dateStyle: 'medium' }).format(new Date(stats.generatedAt))
  : null;

// Provide structured schema so search engines recognize the curated directory and language relations.
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://piindex.dev/#website',
      url: 'https://piindex.dev/',
      name: 'Pi Index',
      description: text.en.description,
      inLanguage: ['en', 'zh-CN'],
    },
    {
      '@type': 'CollectionPage',
      '@id': `${canonicalUrl.href}#webpage`,
      url: canonicalUrl.href,
      name: t.title,
      description: t.description,
      isPartOf: { '@id': 'https://piindex.dev/#website' },
      inLanguage: locale === 'zh' ? 'zh-CN' : 'en',
      about: {
        '@type': 'SoftwareApplication',
        name: 'Pi',
        applicationCategory: 'DeveloperApplication',
      },
    },
  ],
};
---
<!doctype html>
<html lang={locale === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={t.description} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={socialImageUrl.href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1730" />
    <meta property="og:image:height" content="909" />
    <meta property="og:image:alt" content={t.title} />
    <meta property="og:locale" content={locale === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.title} />
    <meta name="twitter:description" content={t.description} />
    <meta name="twitter:image" content={socialImageUrl.href} />
    <meta name="twitter:image:alt" content={t.title} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="alternate" hreflang="en" href={new URL('/', Astro.site).href} />
    <link rel="alternate" hreflang="zh-CN" href={new URL('/zh/', Astro.site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site).href} />
    <title>{t.title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#resources">{t.skip}</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={base} aria-label="Pi Index"><span class="brand-mark" aria-hidden="true">π</span><span><span class="brand-muted">pi</span>index</span></a>
        <nav class="header-links" aria-label={locale === 'zh' ? '主要导航' : 'Main navigation'}>
          <a class="language-link" data-language href={locale === 'en' ? '/zh/' : '/'} lang={locale === 'en' ? 'zh-CN' : 'en'}><Icon name="globe" size={16} />{locale === 'en' ? '中文' : 'English'}</a>
          <a class="github-link" href={repository} aria-label={t.github} target="_blank" rel="noopener noreferrer"><Icon name="github" size={17} /><span>{t.github}</span></a>
          <a class="contribute-link" href={`${repository}/issues/new`} target="_blank" rel="noopener noreferrer"><Icon name="plus" size={16} /><span>{t.contribute}</span></a>
        </nav>
      </div>
    </header>

    <main class="page-shell" data-directory data-interactions data-locale={locale} data-surface="home" data-total={total}>
      <section class="intro" aria-labelledby="page-title">
        <div class="intro-copy">
          <p class="eyebrow"><span class="status-dot"></span>{t.eyebrow}</p>
          <h1 id="page-title">{t.heading}</h1>
          <p class="intro-description">{t.intro}</p>
        </div>
        <div class="intro-stats" aria-label={locale === 'zh' ? '目录统计' : 'Directory statistics'}>
          <div><strong>{total}</strong><span>{t.resources}</span></div>
          <span class="stat-separator" aria-hidden="true"></span>
          <div><strong>{catalog.categories.length}</strong><span>{t.categories.toLowerCase()}</span></div>
        </div>
      </section>

      {(guides.length > 0 || jevPublished) && <nav class="directory-guides" aria-label={locale === 'zh' ? '指南与专题' : 'Guides and topics'}>
        <span class="directory-guides-label">{locale === 'zh' ? '选型指南' : 'Explore the guides'}</span>
        {guides.map(([slug]) => <a class="guide-link" href={routePath('categories', slug, locale)}>{categoryLabel(categoryMap.get(slug)?.name ?? slug, locale)}<span aria-hidden="true">→</span></a>)}
        {jevPublished && <a class="topic-link" href={routePath('topics', 'jev', locale)}>TypeSafe AI / Jev<span aria-hidden="true">→</span></a>}
      </nav>}

      <div class="directory-layout">
        <aside class="sidebar" aria-label={t.filter}>
          <a class="category-all" data-category="all" data-label={t.all} href={base} aria-current="true"><span><Icon name="grid" size={17} />{t.all}</span><span class="category-count">{total}</span></a>
          {kindOrder.map(kind => <div class="category-group">
            <a class="category-group-heading" data-category={kind} data-label={t.kinds[kind]} href={categoryUrl(kind)}><span>{t.kinds[kind]}</span><span>{catalog.resources.filter(resource => resource.kind === kind).length}</span></a>
            {catalog.categories.filter(category => category.kind === kind).map(category => (
              <a class="category-link" data-category={category.id} data-label={categoryLabel(category.name, locale)} href={categoryUrl(category.id)}><span>{categoryLabel(category.name, locale)}</span><span class="category-count">{category.count}</span></a>
            ))}
          </div>)}
          <div class="sidebar-footer"><span class="status-dot"></span>{t.maintained}</div>
        </aside>

        <section class="results" id="resources" aria-labelledby="results-heading">
          <div class="search-box">
            <Icon name="search" size={20} />
            <label class="sr-only" for="search">{t.search}</label>
            <input id="search" type="search" placeholder={t.placeholder} autocomplete="off" spellcheck="false" />
            <button id="clear-search" class="icon-button" aria-label={t.clear} hidden><Icon name="close" size={17} /></button>
          </div>
          <div class="mobile-filter">
            <label for="mobile-category">{t.filter}</label>
            <select id="mobile-category">
              <option value="all">{t.all} ({total})</option>
              {kindOrder.map(kind => <optgroup label={t.kinds[kind]}>
                <option value={kind}>{t.kinds[kind]} ({catalog.resources.filter(resource => resource.kind === kind).length})</option>
                {catalog.categories.filter(category => category.kind === kind).map(category => <option value={category.id}>{categoryLabel(category.name, locale)} ({category.count})</option>)}
              </optgroup>)}
            </select>
          </div>
          <noscript><p class="no-script">{t.noScript}</p></noscript>
          <div class="results-header"><h2 id="results-heading">{t.all}</h2><span id="result-count" aria-live="polite" aria-atomic="true">{locale === 'zh' ? `${total} 项资源` : `${total} resources`}</span></div>
          <div class="resource-list">
            {catalog.resources.map(resource => {
              const descriptions = resource.descriptions[locale];
              const description = descriptions.join(' ');
              const long = description.length > (locale === 'zh' ? 110 : 220);
              const search = `${resource.searchText} ${resource.categories.map(id => categoryLabel(categoryMap.get(id)!.name, 'zh')).join(' ')}`;
              const metrics = statsFor(resource, stats);
              const detailPath = packagePath(resource, locale);
              const destination = repoDestination(resource.url);
              return <article class="resource" id={resource.id} data-resource data-kind={resource.kind} data-categories={resource.categories.join(' ')} data-search={search} data-stars={metrics.stars ?? undefined} data-downloads={metrics.weekly ?? undefined}>
                <div class="resource-heading"><h3>{detailPath ? <a class="package-link" href={detailPath}>{resource.name}</a> : <a href={resource.url} target="_blank" rel="noopener noreferrer" data-repo-link={destination ? true : undefined} data-package={destination ? resource.name : undefined} data-destination={destination}>{resource.name}<Icon name="arrow" size={16} /></a>}</h3>{(metrics.stars !== null || metrics.weekly !== null) && <span class="resource-stats">{metrics.stars !== null && <span class="stat" title={t.statsStars}><Icon name="star" size={15} />{formatCount(metrics.stars, locale)}</span>}{metrics.weekly !== null && <span class="stat" title={t.statsDownloads}><Icon name="download" size={15} />{formatCount(metrics.weekly, locale)}{t.perWeek}{metrics.trend !== null && <span class:list={['trend', metrics.trend >= 0 ? 'up' : 'down']}>{metrics.trend >= 0 ? '▲' : '▼'}{Math.abs(metrics.trend)}%</span>}</span>}</span>}</div>
                <div class="resource-description">
                  {long ? <details class="description-details"><summary><span class="description-preview">{description}</span><span class="details-toggle"><span class="when-closed">{t.more}</span><span class="when-open">{t.less}</span><Icon name="chevron" size={12} /></span></summary><p class="description-full">{description}</p></details> : <p>{description}</p>}
                </div>
                <div class="resource-categories"><a href={categoryUrl(resource.kind)} class="resource-kind" data-category={resource.kind} data-label={t.kinds[resource.kind]}>{t.kinds[resource.kind]}</a>{resource.categories.map(id => <a href={categoryUrl(id)} class="resource-tag" data-category={id} data-label={categoryLabel(categoryMap.get(id)!.name, locale)}>{categoryLabel(categoryMap.get(id)!.name, locale)}</a>)}</div>
                {detailPath && <div class="resource-guide-links"><a class="package-link" href={detailPath}>{locale === 'zh' ? '详情' : 'Guide'}<span aria-hidden="true">→</span></a><a href={resource.url} target="_blank" rel="noopener noreferrer" data-repo-link={destination ? true : undefined} data-package={destination ? resource.name : undefined} data-destination={destination}>{t.project}<Icon name="arrow" size={13} /></a></div>}
                {resource.install ? <div class="install-command"><span class="command-prompt" aria-hidden="true">$</span><code>{resource.install}</code><button class="copy-button" data-copy={resource.install} data-package={resource.name} aria-label={`${t.copyCommand}: ${resource.name}`}><Icon name="copy" size={14} /><span data-copy-label>{t.copy}</span></button></div> : <a class="install-instructions" href={resource.url} target="_blank" rel="noopener noreferrer" data-repo-link={destination ? true : undefined} data-package={destination ? resource.name : undefined} data-destination={destination}>{t.missing}<Icon name="arrow" size={14} /></a>}
              </article>;
            })}
          </div>
          <div class="empty-state" id="empty-state" hidden><Icon name="search" size={32} /><h3>{t.emptyTitle}</h3><p>{t.emptyBody}</p><button data-reset>{t.reset}</button></div>
        </section>
      </div>
      <footer class="site-footer">
        <div><a class="footer-brand" href={base}><span>pi</span>index</a><p>{t.notice}</p>{statsDate && <p class="stats-updated">{t.statsUpdated.replace('{date}', statsDate)}</p>}</div>
        <div class="footer-links">
          <a href={`${repository}/issues/new`} target="_blank" rel="noopener noreferrer">{t.contribute}</a>
          <a href={`${repository}/blob/main/${locale === 'zh' ? 'README.md' : 'README.en.md'}`} target="_blank" rel="noopener noreferrer">{t.source}<Icon name="arrow" size={13} /></a>
          <a href={`${repository}/issues`} target="_blank" rel="noopener noreferrer">{t.report}</a>
          <a href="https://creativecommons.org/publicdomain/zero/1.0/" target="_blank" rel="noopener noreferrer">{t.license}</a>
        </div>
      </footer>
      <p class="copy-status" id="copy-status" role="status" aria-live="polite"></p>
    </main>
    <script>
      import { initializeDirectory } from '../scripts/directory';
      initializeDirectory(document, window);
    </script>
    <Analytics />
  </body>
</html>
