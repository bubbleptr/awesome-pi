---
import { type Locale } from '../lib/catalog';
import { getEditorial } from '../lib/editorial';
import { publishedRoutes, routePath } from '../lib/published-routes';
import GuideIllustration from './GuideIllustration.astro';
import '../styles/directory-guides.css';

const { locale } = Astro.props as { locale: Locale };
const zh = locale === 'zh';
const guides = Object.entries(publishedRoutes.categories).filter(([, route]) => route.status === 'active');
const topics = Object.entries(publishedRoutes.topics).filter(([, route]) => route.status === 'active');
const featuredTopic = 'pi-durable';
const featured = topics.some(([slug]) => slug === featuredTopic) ? featuredTopic : undefined;
const wideTopics = topics.filter(([slug]) => slug !== featuredTopic);
const topicCopy: Record<string, { title?: string; description: string }> = {
  'pi-durable': {
    description: zh ? '在手机、团队聊天和 Home Assistant 中运行可恢复的 Agent。比较各项目的安装方式、版本与数据边界。' : 'Run recoverable agents from your phone, team chat or Home Assistant. Compare setup, versions and data boundaries for each project.',
  },
  jev: {
    title: zh ? 'Jev 决策层' : 'A decision layer with Jev',
    description: zh ? '让 Jev 参与工具判定、技能选择与模型路由。比较不同集成的用途、配置与边界。' : 'Tool judgments, skill selection and model routing. Compare what each Jev integration does and how to set it up.',
  },
};
const topicIllustration: Record<string, 'durable' | 'jev'> = { 'pi-durable': 'durable', jev: 'jev' };
const topicTitle = (slug: string) => {
  const page = getEditorial('topics', slug);
  return topicCopy[slug]?.title ?? page.navLabel?.[locale] ?? page.title[locale].replace(/\s*\| Pi Index$/, '');
};
const copy: Record<string, { title: string; description: string; illustration: 'subagents' | 'web' }> = {
  subagents: {
    title: zh ? '多 Agent 协作' : 'Working with subagents',
    description: zh ? '比较并行任务、上下文隔离与 Worktree 方案。' : 'Compare parallel tasks, context isolation and worktrees.',
    illustration: 'subagents',
  },
  'web-access-search': {
    title: zh ? '联网与搜索' : 'Web access & search',
    description: zh ? '从免 Key 搜索到自托管，找到合适的联网方式。' : 'Find your setup, from keyless search to self-hosted tools.',
    illustration: 'web',
  },
};
---

{(guides.length > 0 || topics.length > 0) && <section class="directory-guides" aria-labelledby="guides-heading">
  <header class="guides-heading">
    <div>
      <h2 id="guides-heading">{zh ? '热门扩展选型指南' : 'Guides to popular extensions'}</h2>
      <p>{zh ? '按使用场景比较方案，找到适合你的 Pi 扩展。' : 'Compare approaches and find the right extensions for your workflow.'}</p>
    </div>
    <a class="guides-directory-link" href="#resources">{zh ? '浏览全部资源' : 'Browse all resources'}<span aria-hidden="true">↓</span></a>
  </header>
  <nav class="guides-grid" aria-labelledby="guides-heading">
    {featured && <article class="guide-card guide-card--featured">
      <div class="guide-card-copy">
        <span class="guide-kicker"><span aria-hidden="true"></span>{zh ? '热点专题' : 'In focus'}</span>
        <h3>{topicTitle(featured)}</h3>
        <p>{topicCopy[featured]?.description ?? getEditorial('topics', featured).description[locale]}</p>
        <a class="topic-link guide-card-link" data-guide={featured} data-placement="home_bento" href={routePath('topics', featured, locale)} aria-label={zh ? `查看专题：${topicTitle(featured)}` : `Explore the guide: ${topicTitle(featured)}`}>{zh ? '查看专题' : 'Explore the guide'}<span aria-hidden="true">↗</span></a>
      </div>
      {topicIllustration[featured] && <div class="guide-art guide-art--featured"><GuideIllustration variant={topicIllustration[featured]} locale={locale} /></div>}
    </article>}
    {guides.map(([slug]) => {
      const card = copy[slug];
      const page = getEditorial('categories', slug);
      const title = card?.title ?? page.title[locale];
      return <article class="guide-card guide-card--compact">
        <div class="guide-card-copy">
          <h3>{title}</h3>
          <p>{card?.description ?? page.description[locale]}</p>
          <a class="guide-link guide-card-link" data-guide={slug} data-placement="home_bento" href={routePath('categories', slug, locale)} aria-label={zh ? `比较方案：${title}` : `Compare options: ${title}`}>{zh ? '比较方案' : 'Compare options'}<span aria-hidden="true">↗</span></a>
        </div>
        {card && <div class="guide-art guide-art--compact"><GuideIllustration variant={card.illustration} locale={locale} /></div>}
      </article>;
    })}
    {wideTopics.map(([slug]) => {
      const page = getEditorial('topics', slug);
      const title = topicTitle(slug);
      return <article class="guide-card guide-card--compact guide-card--wide">
        <div class="guide-card-copy">
          <h3>{title}</h3>
          <p>{topicCopy[slug]?.description ?? page.description[locale]}</p>
          <a class="topic-link guide-card-link" data-guide={slug} data-placement="home_bento" href={routePath('topics', slug, locale)} aria-label={zh ? `查看专题：${title}` : `Explore the guide: ${title}`}>{zh ? '查看专题' : 'Explore the guide'}<span aria-hidden="true">↗</span></a>
        </div>
      </article>;
    })}
  </nav>
</section>}
