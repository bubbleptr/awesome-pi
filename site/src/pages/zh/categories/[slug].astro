---
import EditorialPage from '../../../components/EditorialPage.astro';
import { getPublishedSlugs } from '../../../lib/published-routes';

export function getStaticPaths() {
  return getPublishedSlugs('categories').map(slug => ({ params: { slug } }));
}
const { slug } = Astro.params;
---
<EditorialPage kind="categories" slug={slug} locale="zh" />
