{
  "name": "awesome-pi-site",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.12",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "stats": "bun run scripts/update-stats.ts",
    "test": "bun test tests/catalog.test.ts tests/directory.test.ts tests/stats.test.ts tests/routes.test.ts tests/endpoint.test.ts",
    "test:rendered": "bun test tests/rendered.test.ts",
    "validate": "bun run test && bun run check && bun run build && bun run test:rendered"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@vercel/analytics": "2.0.1",
    "astro": "7.3.1",
    "mdast-util-to-string": "4.0.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/bun": "1.3.12",
    "@types/mdast": "4.0.4",
    "typescript": "~5.9.3",
    "happy-dom": "^20.8.4"
  }
}
